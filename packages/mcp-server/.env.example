# Security Audit MCP Server — Environment Variables
# Copy to .env and fill in your values.

# ── Auth ──────────────────────────────────────────────
# Option 1: Simple comma-separated API keys (no DB needed)
SECURITY_AUDIT_API_KEYS=

# Option 2: Skip auth entirely (local/stdio mode)
# SECURITY_AUDIT_SKIP_AUTH=true

# ── Database (enables DB-backed auth + usage tracking) ──
# Neon: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
# Local: postgresql://secaudit:secaudit_local@localhost:5432/secaudit
DATABASE_URL=

# ── Clerk (future: dashboard JWT verification) ───────
# CLERK_SECRET_KEY=sk_live_...

# ── Server ────────────────────────────────────────────
PORT=3000
